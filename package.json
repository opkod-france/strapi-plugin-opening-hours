{
  "name": "@opkod-france/strapi-plugin-opening-hours",
  "version": "1.0.0",
  "description": "A Strapi custom field plugin for managing business opening hours with split shifts and special/holiday hours",
  "license": "MIT",
  "homepage": "https://github.com/opkod-france/strapi-plugin-opening-hours#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/opkod-france/strapi-plugin-opening-hours.git"
  },
  "bugs": {
    "url": "https://github.com/opkod-france/strapi-plugin-opening-hours/issues"
  },
  "keywords": [
    "strapi",
    "strapi-plugin",
    "strapi-v5",
    "opening-hours",
    "custom-field",
    "schema-org",
    "business-hours"
  ],
  "exports": {
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "strapi-server.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "verify": "strapi-plugin verify",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watchAll",
    "prepare": "husky"
  },
  "dependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "react-intl": "^7.1.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@strapi/sdk-plugin": "^5.0.0",
    "@strapi/strapi": "^5.0.0",
    "@strapi/typescript-utils": "^5.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "semantic-release": "^25.0.3",
    "styled-components": "^6.0.0",
    "ts-jest": "^29.4.6",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "strapi": {
    "name": "opening-hours",
    "description": "Opening hours custom field for business schedules",
    "kind": "plugin",
    "displayName": "Opening Hours"
  }
}
